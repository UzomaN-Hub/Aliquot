# API settings. Copy to apps/api/.env (gitignored). Every line without a default is required.

ENVIRONMENT=local
PLATFORM_NAME=Aliquot
PLATFORM_DOMAIN=localhost
TENANT_MODE=path

# Database: the API logs in as aliquot_app (can't bypass RLS); migrations as the owner.
# Local values match infra/docker-compose.yml. Then run: uv run python -m app.scripts.dev_db
DATABASE_URL=postgresql+psycopg://aliquot_app:aliquot_app_dev@127.0.0.1:5432/aliquot
MIGRATION_DATABASE_URL=postgresql+psycopg://aliquot:aliquot_dev@127.0.0.1:5432/aliquot

# Signs access tokens. At least 32 random characters, different in every environment.
# PowerShell: -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Maximum 16) })
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional (defaults shown)
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# SESSION_IDLE_HOURS=8
