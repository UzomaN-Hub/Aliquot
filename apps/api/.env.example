# API settings. Copy to apps/api/.env (gitignored). Every line without a default is required.

ENVIRONMENT=local
PLATFORM_NAME=Aliquot
PLATFORM_DOMAIN=localhost
TENANT_MODE=path

# Database roles (decisions 012, 015). Local values match infra/docker-compose.yml.
# Then run: uv run python -m app.scripts.dev_db
#   aliquot_app       the lab app; can never bypass row-level security
#   aliquot_platform  the console; tenant records only, never staff or clinical data
#   owner             migrations and dev scripts only
DATABASE_URL=postgresql+psycopg://aliquot_app:aliquot_app_dev@127.0.0.1:5432/aliquot
PLATFORM_DATABASE_URL=postgresql+psycopg://aliquot_platform:aliquot_platform_dev@127.0.0.1:5432/aliquot
MIGRATION_DATABASE_URL=postgresql+psycopg://aliquot:aliquot_dev@127.0.0.1:5432/aliquot

# Invite and reset links point here (no trailing slash).
PUBLIC_WEB_URL=http://localhost:3000

# Signs access tokens. At least 32 random characters, different in every environment.
# PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | ForEach-Object { $_.ToString('x2') }) -join ''
JWT_SECRET=replace-with-at-least-32-random-characters

# Encrypts super-admin 2FA secrets at rest. Generate one per environment:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=replace-with-a-fernet-key

# Optional (defaults shown)
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=7
# SESSION_IDLE_HOURS=8
