# Web settings. Copy to apps/web/.env.local (gitignored). Every line is required.

PLATFORM_NAME=Aliquot
PLATFORM_DOMAIN=localhost
TENANT_MODE=path
# The FastAPI service; /api/v1/* is proxied here (decision 003).
# 127.0.0.1, not localhost: Node tries IPv6 (::1) first and the API listens on IPv4.
API_URL=http://127.0.0.1:8000
# Optional. /styleguide is always on in `pnpm dev`; set true to show it on a deployed build.
STYLEGUIDE_ENABLED=false
# Optional. "Book a demo" writes here; without it the landing says demo bookings open soon.
# CONTACT_EMAIL=hello@example.com
